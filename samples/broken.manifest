# envelopeseal broken manifest, test vector authored by hand.
# See samples/README.md for how this was constructed.
# It deliberately contains one of each fault the tool detects:
#   inversion : weak-wrapper (level 112) wraps dek-strong (level 256)
#   cycle     : loop-a -> loop-b -> loop-a
#   orphan    : lonely-kek has no wrap edge in either direction
#   overdue   : dek-stale rotation lapsed well before the README as-of date
#   missing-wrap : dek-uncovered is a data key wrapped by nothing

key root-hsm       kek AES-KW    256 2026-01-01 0
key weak-wrapper   kek RSA-OAEP 2048 2026-01-01 365
key loop-a         kek AES-KW    256 2026-01-01 365
key loop-b         kek AES-KW    256 2026-01-01 365
key lonely-kek     kek AES-KW    256 2026-01-01 365

key dek-strong     dek AES-GCM   256 2026-07-01 90
key dek-stale      dek AES-GCM   256 2026-01-01 30
key dek-uncovered  dek AES-GCM   256 2026-07-01 90
