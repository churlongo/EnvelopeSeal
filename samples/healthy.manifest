# envelopeseal healthy manifest, test vector authored by hand.
# See samples/README.md for how this was constructed.
# Layout: one root wraps two mid keks; each mid kek wraps data keys.
# All strengths are non-decreasing down the tree, so no inversion.
# as-of used in the README is 2026-09-02; all rotation intervals are still open.

# root of trust, replaced by ceremony not schedule, so rotation is exempt (0)
key root-hsm            kek AES-KW    256 2026-01-01 0
key mid-payments-kek    kek AES-KW    256 2026-02-01 365
key mid-telemetry-kek   kek AES-KW    256 2026-02-01 365

key dek-orders          dek AES-GCM   256 2026-07-01 90
key dek-invoices        dek AES-GCM   256 2026-07-01 90
key dek-events          dek AES-GCM   256 2026-07-15 90
key dek-metrics         dek AES-GCM   256 2026-07-15 90

wrap root-hsm            mid-payments-kek
wrap root-hsm            mid-telemetry-kek
wrap mid-payments-kek    dek-orders
wrap mid-payments-kek    dek-invoices
wrap mid-telemetry-kek   dek-events
wrap mid-telemetry-kek   dek-metrics
